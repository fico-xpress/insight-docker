WORKBENCH_VERSION=3.19.3
IMAGE_WORKBENCH=registry.hub.docker.com/ficoxpress/xpress-workbench-local

WORKBENCH_EXTERNAL_PORT=9595
# Specify the value workbench-data to store your projects in the internal docker volume
# Specify an accessible absolute path on your host system to store your projects outside the container
WORKBENCH_DATA_VOLUME=
